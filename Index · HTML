<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin – Rádio Jovem FM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  :root{
    --gold:#F5A623;--orange:#E8650A;--pink:#E91E8C;--blue:#00C2FF;
    --dark:#08080F;--dark2:#0F0F1A;--dark3:#161625;--dark4:#1E1E32;
    --border:rgba(245,166,35,0.18);--text:#F0EEE8;--muted:#7A7890;
  }
  body{font-family:'Barlow',sans-serif;background:var(--dark);color:var(--text);min-height:100vh}

  /* LOGIN */
  #loginScreen{position:fixed;inset:0;background:var(--dark);z-index:999;display:flex;align-items:center;justify-content:center}
  .login-card{background:var(--dark3);border:1px solid var(--border);border-radius:20px;padding:40px;width:100%;max-width:380px;position:relative;overflow:hidden}
  .login-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--orange),var(--gold),var(--pink))}
  .login-logo{text-align:center;margin-bottom:28px}
  .login-logo img{height:80px;width:80px;object-fit:contain;border-radius:12px}
  .login-logo h2{font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:700;margin-top:10px;background:linear-gradient(90deg,var(--gold),var(--pink));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
  .login-logo p{font-size:12px;color:var(--muted);margin-top:4px}
  .login-form .form-group{margin-bottom:14px}
  .login-form label{display:block;font-size:11px;color:var(--muted);margin-bottom:6px;letter-spacing:0.5px;text-transform:uppercase}
  .login-form input{width:100%;background:var(--dark4);border:1px solid var(--border);color:var(--text);padding:12px 16px;border-radius:10px;font-family:'Barlow',sans-serif;font-size:14px;outline:none;transition:border-color .2s}
  .login-form input:focus{border-color:var(--gold)}
  .login-form input::placeholder{color:var(--muted)}
  .btn-login{width:100%;background:linear-gradient(135deg,var(--orange),var(--gold));border:none;color:#000;font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700;padding:13px;border-radius:10px;cursor:pointer;letter-spacing:1px;margin-top:6px;transition:opacity .2s}
  .btn-login:hover{opacity:0.85}
  .login-hint{text-align:center;font-size:11px;color:var(--muted);margin-top:14px}

  /* LAYOUT */
  #adminApp{display:none;flex-direction:column;min-height:100vh}
  #adminApp.visible{display:flex}

  .topbar{background:var(--dark2);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;height:60px;position:sticky;top:0;z-index:50}
  .topbar-left{display:flex;align-items:center;gap:14px}
  .topbar-logo{display:flex;align-items:center;gap:10px}
  .topbar-logo img{height:32px;width:32px;object-fit:contain;border-radius:6px}
  .topbar-logo span{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:17px;letter-spacing:1px;background:linear-gradient(90deg,var(--gold),var(--pink));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
  .on-air{display:flex;align-items:center;gap:7px;background:rgba(233,30,140,0.12);border:1px solid rgba(233,30,140,0.35);color:var(--pink);font-size:11px;font-weight:700;padding:4px 12px;border-radius:20px;letter-spacing:1.5px}
  .pulse-dot{width:7px;height:7px;background:var(--pink);border-radius:50%;animation:pd 1.4s infinite}
  @keyframes pd{0%,100%{opacity:1}50%{opacity:0.2}}
  .topbar-right{display:flex;align-items:center;gap:10px}
  .topbar-right button{background:transparent;border:1px solid var(--border);color:var(--muted);padding:6px 14px;border-radius:7px;font-family:'Barlow',sans-serif;font-size:13px;cursor:pointer;transition:all .2s}
  .topbar-right button:hover{border-color:var(--gold);color:var(--gold)}
  .btn-primary{background:linear-gradient(135deg,var(--orange),var(--gold)) !important;border:none !important;color:#000 !important;font-weight:700 !important}
  .btn-primary:hover{opacity:0.85 !important}
  .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:transparent;border:none}
  .hamburger span{width:22px;height:2px;background:var(--gold);border-radius:2px}

  .body-wrap{display:flex;flex:1}

  /* SIDEBAR */
  .sidebar{width:210px;background:var(--dark2);border-right:1px solid var(--border);padding:16px 0;flex-shrink:0;transition:transform .3s}
  .nav-section{padding:0 12px;margin-bottom:20px}
  .nav-label{font-size:10px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;padding:0 8px;margin-bottom:8px}
  .nav-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:13px;color:var(--muted);transition:all .2s;margin-bottom:2px;border:none;background:transparent;width:100%;text-align:left}
  .nav-item:hover{background:rgba(245,166,35,0.08);color:var(--text)}
  .nav-item.active{background:rgba(245,166,35,0.14);color:var(--gold)}
  .nav-item i{width:18px;text-align:center;font-size:14px}
  .nav-badge{margin-left:auto;background:var(--pink);color:#fff;border-radius:10px;font-size:10px;padding:1px 7px;font-weight:700}

  /* CONTENT */
  .content{flex:1;padding:24px;overflow-y:auto;min-height:0}
  .page{display:none}
  .page.active{display:block}
  .page-title{font-family:'Rajdhani',sans-serif;font-size:24px;font-weight:700;letter-spacing:1px;margin-bottom:20px;color:var(--gold);display:flex;align-items:center;gap:10px}

  /* CARDS */
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
  .stat-card{background:var(--dark3);border:1px solid var(--border);border-radius:12px;padding:16px;position:relative;overflow:hidden}
  .stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
  .stat-card.c-gold::before{background:linear-gradient(90deg,var(--orange),var(--gold))}
  .stat-card.c-pink::before{background:linear-gradient(90deg,var(--pink),#7B2FBE)}
  .stat-card.c-blue::before{background:linear-gradient(90deg,var(--blue),#7B2FBE)}
  .stat-card.c-green::before{background:linear-gradient(90deg,#00E676,#00BFA5)}
  .stat-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
  .stat-value{font-family:'Rajdhani',sans-serif;font-size:30px;font-weight:700;color:var(--text)}
  .stat-sub{font-size:11px;color:var(--muted);margin-top:2px}
  .stat-ico{position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:28px;opacity:0.1;color:var(--gold)}

  .card{background:var(--dark3);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:14px}
  .card-title{font-family:'Rajdhani',sans-serif;font-size:15px;font-weight:600;letter-spacing:0.5px;color:var(--text);margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .card-title i{color:var(--gold);font-size:14px}

  /* NOW PLAYING */
  .now-card{background:linear-gradient(135deg,rgba(232,101,10,0.08),rgba(233,30,140,0.08));border:1px solid rgba(245,166,35,0.28);border-radius:12px;padding:18px;margin-bottom:18px;display:flex;align-items:center;gap:16px}
  .vinyl{width:54px;height:54px;border-radius:50%;background:var(--dark4);border:3px solid var(--gold);display:flex;align-items:center;justify-content:center;animation:spin 5s linear infinite;flex-shrink:0}
  @keyframes spin{to{transform:rotate(360deg)}}
  .vinyl i{font-size:20px;color:var(--gold)}
  .np-info{flex:1}
  .np-title{font-family:'Rajdhani',sans-serif;font-size:17px;font-weight:700}
  .np-sub{font-size:12px;color:var(--muted);margin-top:2px}
  .np-ctrl{display:flex;gap:8px}
  .ctrl-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s}
  .ctrl-btn:hover{border-color:var(--gold);color:var(--gold)}
  .ctrl-play{background:linear-gradient(135deg,var(--orange),var(--gold)) !important;border:none !important;color:#000 !important;font-size:16px !important}

  /* CHART */
  .mini-chart{display:flex;align-items:flex-end;gap:4px;height:64px;margin-top:8px}
  .mc-col{display:flex;flex-direction:column;align-items:center;gap:4px;flex:1}
  .mc-bar{width:100%;border-radius:3px 3px 0 0;background:linear-gradient(180deg,var(--gold),var(--orange));min-height:4px;transition:height .4s}
  .mc-label{font-size:9px;color:var(--muted)}

  /* TABLE */
  .data-table{width:100%;font-size:13px;border-collapse:collapse}
  .data-table th{text-align:left;padding:8px;font-size:10px;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;border-bottom:1px solid var(--border)}
  .data-table td{padding:10px 8px;border-bottom:1px solid rgba(245,166,35,0.05);vertical-align:middle}
  .data-table tr:hover td{background:rgba(245,166,35,0.03)}
  .status-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:5px}
  .dot-green{background:#00E676}
  .dot-yellow{background:var(--gold)}
  .dot-red{background:var(--pink)}

  /* PEDIDOS */
  .req-list{display:flex;flex-direction:column;gap:8px}
  .req-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--dark4);border-radius:10px;font-size:13px}
  .req-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--orange),var(--pink));display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#000;flex-shrink:0}
  .req-info{flex:1}
  .req-name{color:var(--text);font-weight:600}
  .req-song{color:var(--muted);font-size:11px;margin-top:1px}
  .req-time{font-size:11px;color:var(--muted);margin-right:6px}
  .req-btn{padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;border:none;transition:all .2s;font-family:'Barlow',sans-serif}
  .rb-ok{background:rgba(0,230,118,0.15);color:#00E676}
  .rb-ok:hover{background:rgba(0,230,118,0.28)}
  .rb-no{background:rgba(233,30,140,0.15);color:var(--pink);margin-left:4px}
  .rb-no:hover{background:rgba(233,30,140,0.28)}

  /* FORMS */
  .form-group{margin-bottom:14px}
  .form-label{display:block;font-size:11px;color:var(--muted);margin-bottom:6px;letter-spacing:0.5px;text-transform:uppercase}
  .form-input, .form-select, .form-textarea{width:100%;background:var(--dark4);border:1px solid var(--border);color:var(--text);padding:10px 14px;border-radius:9px;font-family:'Barlow',sans-serif;font-size:13px;outline:none;transition:border-color .2s}
  .form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--gold)}
  .form-textarea{resize:vertical;min-height:90px}
  .form-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .upload-zone{border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;cursor:pointer;transition:all .2s;color:var(--muted);font-size:13px}
  .upload-zone:hover{border-color:var(--gold);color:var(--gold)}
  .upload-zone i{font-size:30px;display:block;margin-bottom:8px}

  /* BUTTONS */
  .btn{padding:9px 20px;border-radius:8px;font-family:'Barlow',sans-serif;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:all .2s;letter-spacing:0.5px;display:inline-flex;align-items:center;gap:6px}
  .btn-gold{background:linear-gradient(135deg,var(--orange),var(--gold));color:#000}
  .btn-gold:hover{opacity:0.85}
  .btn-ghost{background:transparent;border:1px solid var(--border) !important;color:var(--muted)}
  .btn-ghost:hover{border-color:var(--gold) !important;color:var(--gold)}
  .btn-pink{background:linear-gradient(135deg,var(--pink),var(--orange));color:#fff}

  /* SCHEDULE */
  .sch-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid rgba(245,166,35,0.07);align-items:center}
  .sch-item:last-child{border-bottom:none}
  .sch-time{font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:700;color:var(--gold);width:52px;flex-shrink:0}
  .sch-show{font-size:13px;color:var(--text);font-weight:500}
  .sch-host{font-size:11px;color:var(--muted)}
  .sch-live{background:rgba(233,30,140,0.15);color:var(--pink);font-size:10px;padding:2px 9px;border-radius:10px;margin-left:auto;border:1px solid rgba(233,30,140,0.3);font-weight:700;letter-spacing:0.5px}
  .sch-edit{margin-left:8px;background:transparent;border:1px solid var(--border);color:var(--muted);width:26px;height:26px;border-radius:6px;cursor:pointer;font-size:11px;display:flex;align-items:center;justify-content:center;transition:all .2s}
  .sch-edit:hover{border-color:var(--gold);color:var(--gold)}

  /* TOAST */
  .toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);background:linear-gradient(135deg,var(--orange),var(--gold));color:#000;font-weight:700;padding:13px 26px;border-radius:12px;font-size:14px;z-index:9999;transition:transform .35s;white-space:nowrap;pointer-events:none}
  .toast.show{transform:translateX(-50%) translateY(0)}

  @media(max-width:768px){
    .sidebar{position:fixed;top:60px;left:0;bottom:0;z-index:40;transform:translateX(-100%)}
    .sidebar.open{transform:translateX(0)}
    .hamburger{display:flex}
    .stats-grid{grid-template-columns:repeat(2,1fr)}
    .form-row2{grid-template-columns:1fr}
  }
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-card">
    <div class="login-logo">
      <img src="../assets/logo.png" alt="Logo" onerror="this.style.display='none'">
      <h2>RÁDIO JOVEM FM</h2>
      <p>Painel Administrativo</p>
    </div>
    <div class="login-form">
      <div class="form-group">
        <label>Usuário</label>
        <input type="text" id="loginUser" placeholder="admin" autocomplete="username">
      </div>
      <div class="form-group">
        <label>Senha</label>
        <input type="password" id="loginPass" placeholder="••••••" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()">
      </div>
      <button class="btn-login" onclick="doLogin()"><i class="fas fa-lock"></i> ENTRAR</button>
      <p class="login-hint">Usuário padrão: <strong>admin</strong> / Senha: <strong>jovemfm</strong><br>Altere no código admin/index.html</p>
    </div>
  </div>
</div>

<!-- ADMIN APP -->
<div id="adminApp">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-left">
      <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <div class="topbar-logo">
        <img src="../assets/logo.png" alt="Logo" onerror="this.style.display='none'">
        <span>JOVEM FM ADMIN</span>
      </div>
      <div class="on-air"><span class="pulse-dot"></span> NO AR</div>
    </div>
    <div class="topbar-right">
      <button onclick="window.open('../index.html','_blank')"><i class="fas fa-external-link-alt"></i> Ver Site</button>
      <button class="btn-primary" onclick="showToast('🎙️ Transmissão iniciada!')"><i class="fas fa-broadcast-tower"></i> Transmitir</button>
      <button onclick="doLogout()" style="color:var(--pink) !important"><i class="fas fa-sign-out-alt"></i></button>
    </div>
  </div>

  <div class="body-wrap">
    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">
      <div class="nav-section">
        <div class="nav-label">Principal</div>
        <button class="nav-item active" onclick="navTo('dashboard',this)"><i class="fas fa-th-large"></i> Dashboard</button>
        <button class="nav-item" onclick="navTo('pedidos',this)"><i class="fas fa-comments"></i> Pedidos <span class="nav-badge" id="badgeCount">0</span></button>
        <button class="nav-item" onclick="navTo('musicas',this)"><i class="fas fa-music"></i> Músicas</button>
        <button class="nav-item" onclick="navTo('agenda',this)"><i class="fas fa-calendar-alt"></i> Agenda</button>
      </div>
      <div class="nav-section">
        <div class="nav-label">Conteúdo</div>
        <button class="nav-item" onclick="navTo('upload',this)"><i class="fas fa-cloud-upload-alt"></i> Upload</button>
        <button class="nav-item" onclick="navTo('publicidade',this)"><i class="fas fa-bullhorn"></i> Publicidade</button>
        <button class="nav-item" onclick="navTo('locutores',this)"><i class="fas fa-microphone"></i> Locutores</button>
      </div>
      <div class="nav-section">
        <div class="nav-label">Sistema</div>
        <button class="nav-item" onclick="navTo('config',this)"><i class="fas fa-cog"></i> Configurações</button>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <!-- ===== DASHBOARD ===== -->
      <div class="page active" id="p-dashboard">
        <div class="page-title"><i class="fas fa-th-large"></i> Dashboard</div>

        <div class="now-card">
          <div class="vinyl"><i class="fas fa-music"></i></div>
          <div class="np-info">
            <div class="np-title" id="npTitle">Selecione uma música ou inicie o stream</div>
            <div class="np-sub">Programa: Sertanejo Total · 14h00 · Marcos Vieira</div>
          </div>
          <div class="np-ctrl">
            <button class="ctrl-btn" title="Anterior"><i class="fas fa-step-backward"></i></button>
            <button class="ctrl-btn ctrl-play" onclick="showToast('▶ Stream iniciado!')" title="Tocar"><i class="fas fa-play"></i></button>
            <button class="ctrl-btn" title="Próxima"><i class="fas fa-step-forward"></i></button>
            <button class="ctrl-btn" onclick="showToast('🔇 Mudo ativado!')" title="Mudo"><i class="fas fa-volume-mute"></i></button>
          </div>
        </div>

        <div class="stats-grid">
          <div class="stat-card c-gold">
            <div class="stat-label">Ouvintes Agora</div>
            <div class="stat-value" id="dashListeners">1.284</div>
            <div class="stat-sub">↑ 12% esta hora</div>
            <i class="fas fa-headphones stat-ico"></i>
          </div>
          <div class="stat-card c-pink">
            <div class="stat-label">Pedidos Hoje</div>
            <div class="stat-value" id="dashPedidos">0</div>
            <div class="stat-sub"><span id="dashPending">0</span> aguardando</div>
            <i class="fas fa-comments stat-ico"></i>
          </div>
          <div class="stat-card c-blue">
            <div class="stat-label">Músicas</div>
            <div class="stat-value" id="dashMusicas">0</div>
            <div class="stat-sub">no acervo</div>
            <i class="fas fa-music stat-ico"></i>
          </div>
          <div class="stat-card c-green">
            <div class="stat-label">Uptime</div>
            <div class="stat-value">99.9%</div>
            <div class="stat-sub">últimos 30 dias</div>
            <i class="fas fa-wifi stat-ico"></i>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div class="card">
            <div class="card-title"><i class="fas fa-chart-bar"></i> Ouvintes por Hora</div>
            <div class="mini-chart" id="miniChart"></div>
          </div>
          <div class="card">
            <div class="card-title"><i class="fas fa-calendar-day"></i> Programação Hoje</div>
            <div class="sch-item"><span class="sch-time">14h00</span><div><div class="sch-show">Sertanejo Total</div><div class="sch-host">Marcos Vieira</div></div><span class="sch-live">AO VIVO</span></div>
            <div class="sch-item"><span class="sch-time">16h00</span><div><div class="sch-show">Flash Hit</div><div class="sch-host">Ana Paula</div></div></div>
            <div class="sch-item"><span class="sch-time">18h00</span><div><div class="sch-show">Drive Total</div><div class="sch-host">Ricardo Fonseca</div></div></div>
            <div class="sch-item"><span class="sch-time">20h00</span><div><div class="sch-show">Noite Romântica</div><div class="sch-host">Automático</div></div></div>
          </div>
        </div>
      </div>

      <!-- ===== PEDIDOS ===== -->
      <div class="page" id="p-pedidos">
        <div class="page-title"><i class="fas fa-comments"></i> Pedidos de Música</div>
        <div class="card" style="margin-bottom:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
            <div class="card-title" style="margin-bottom:0"><i class="fas fa-clock"></i> Aguardando aprovação</div>
            <button class="btn btn-ghost" onclick="clearPedidos()"><i class="fas fa-trash"></i> Limpar Todos</button>
          </div>
          <div class="req-list" id="pedidosList">
            <p style="color:var(--muted);font-size:13px;text-align:center;padding:20px">Nenhum pedido ainda. Os pedidos do site aparecem aqui.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-title"><i class="fas fa-plus"></i> Adicionar Pedido Manual</div>
          <div class="form-row2">
            <div class="form-group"><label class="form-label">Nome do Ouvinte</label><input class="form-input" id="pNome" placeholder="Ex: Maria Silva"></div>
