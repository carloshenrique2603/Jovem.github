<div class="toast" id="toast"></div>

<script>
// ============================================================
// CONFIGURAÇÕES PADRÃO — altere aqui ou via painel
// ============================================================
const DEFAULTS = {
  user: 'admin',
  pass: 'jovemfm',
  stream: '',
  whats: '5545999999999',
  site: ''
};

// ============================================================
// LOGIN
// ============================================================
function doLogin() {
  const cfg = loadCfg();
  const u = document.getElementById('loginUser').value.trim();
  const p = document.getElementById('loginPass').value.trim();
  if (u === cfg.user && p === cfg.pass) {
    sessionStorage.setItem('jfm_auth', '1');
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('adminApp').classList.add('visible');
    initApp();
  } else {
    showToast('Usuário ou senha incorretos!');
    document.getElementById('loginPass').value = '';
  }
}
function doLogout() {
  sessionStorage.removeItem('jfm_auth');
  location.reload();
}
if (sessionStorage.getItem('jfm_auth') === '1') {
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('adminApp').classList.add('visible');
  setTimeout(initApp, 100);
}

// ============================================================
// STORAGE HELPERS
// ============================================================
function ls(key, def) { try { return JSON.parse(localStorage.getItem(key)) ?? def; } catch { return def; } }
function ss(key, val) { localStorage.setItem(key, JSON.stringify(val)); }
function loadCfg() { return ls('jfm_config', DEFAULTS); }
function saveCfg(c) { ss('jfm_config', c); }

// ============================================================
// INIT
// ============================================================
function initApp() {
  buildChart();
  refreshStats();
  renderMusicTable();
  loadConfig();
  loadAnunciantes();
  renderPedidos();
  setInterval(refreshStats, 10000);
}

// ============================================================
// NAVIGATION
// ============================================================
function navTo(id, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('p-' + id).classList.add('active');
  el.classList.add('active');
  if (window.innerWidth < 768) document.getElementById('sidebar').classList.remove('open');
}
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
}

// ============================================================
// STATS
// ============================================================
function refreshStats() {
  const musicas = ls('jfm_musicas', []);
  const pedidos = ls('jfm_pedidos', []);
  const pending = pedidos.filter(p => p.status === 'aguardando').length;
  document.getElementById('dashMusicas').textContent = musicas.length;
  document.getElementById('dashPedidos').textContent = pedidos.length;
  document.getElementById('dashPending').textContent = pending;
  document.getElementById('badgeCount').textContent = pending;
  document.getElementById('dashListeners').textContent = (1150 + Math.floor(Math.random() * 250)).toLocaleString('pt-BR');
}

// ============================================================
// MINI CHART
// ============================================================
function buildChart() {
  const hours = ['08h','09h','10h','11h','12h','13h','14h','agora'];
  const vals   = [22,30,45,38,55,42,60,52];
  const el = document.getElementById('miniChart');
  el.innerHTML = '';
  hours.forEach((h, i) => {
    const col = document.createElement('div');
    col.className = 'mc-col';
    const isNow = h === 'agora';
    col.innerHTML = `<div class="mc-bar" style="height:${vals[i]}px;${isNow?'background:linear-gradient(180deg,var(--pink),var(--orange))':''}"></div><div class="mc-label" style="${isNow?'color:var(--gold);font-weight:700':''}">${h}</div>`;
    el.appendChild(col);
  });
}

// ============================================================
// MÚSICAS
// ============================================================
const musicasDemo = [
  {titulo:'Evidências',artista:'Chitãozinho & Xororó',genero:'Sertanejo',status:'ativo'},
  {titulo:'Amor de Verdade',artista:'Zé Neto e Cristiano',genero:'Sertanejo',status:'ativo'},
  {titulo:'Trem Bala',artista:'Ana Vilela',genero:'Pop',status:'ativo'},
  {titulo:'Menina Saudade',artista:'Marília Mendonça',genero:'Sertanejo',status:'bloqueado'},
];
if (!localStorage.getItem('jfm_musicas')) ss('jfm_musicas', musicasDemo);

function renderMusicTable() {
  const q = (document.getElementById('searchMusic').value || '').toLowerCase();
  const g = document.getElementById('filterGenre').value;
  let musicas = ls('jfm_musicas', []);
  if (q) musicas = musicas.filter(m => m.titulo.toLowerCase().includes(q) || m.artista.toLowerCase().includes(q));
  if (g) musicas = musicas.filter(m => m.genero === g);
  const tbody = document.getElementById('musicBody');
  tbody.innerHTML = '';
  musicas.forEach((m, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td style="color:var(--muted);font-size:11px">${i+1}</td>
      <td style="font-weight:500">${m.titulo}</td>
      <td style="color:var(--muted)">${m.artista}</td>
      <td><span style="background:rgba(245,166,35,0.1);color:var(--gold);font-size:11px;padding:2px 10px;border-radius:8px">${m.genero}</span></td>
      <td><span class="status-dot ${m.status==='ativo'?'dot-green':'dot-yellow'}"></span>${m.status==='ativo'?'Ativo':'Bloqueado'}</td>
      <td>
        <button class="req-btn rb-ok" onclick="playMusic('${m.titulo}')"><i class="fas fa-play"></i></button>
        <button class="req-btn rb-no" style="margin-left:4px" onclick="deleteMusic(${i})"><i class="fas fa-trash"></i></button>
      </td>`;
    tbody.appendChild(tr);
  });
  document.getElementById('musicCount').textContent = ls('jfm_musicas', []).length;
}
function playMusic(titulo) {
  document.getElementById('npTitle').textContent = titulo;
  showToast('▶ Tocando: ' + titulo);
}
function deleteMusic(idx) {
  const musicas = ls('jfm_musicas', []);
  const real = musicas.filter((m, i) => {
    const q = (document.getElementById('searchMusic').value || '').toLowerCase();
    const g = document.getElementById('filterGenre').value;
    if (q && !m.titulo.toLowerCase().includes(q) && !m.artista.toLowerCase().includes(q)) return false;
    if (g && m.genero !== g) return false;
    return true;
  });
  const toRemove = real[idx];
  const newList = musicas.filter(m => m !== toRemove);
  ss('jfm_musicas', newList);
  renderMusicTable();
  showToast('Música removida!');
}

// ============================================================
// UPLOAD
// ============================================================
function handleFile(input) {
  const file = input.files[0];
  if (!file) return;
  const info = document.getElementById('fileInfo');
  info.style.display = 'block';
  info.innerHTML = `<i class="fas fa-check-circle"></i> ${file.name} (${(file.size/1024/1024).toFixed(2)} MB) — pronto para cadastrar`;
  const name = file.name.replace(/\.[^.]+$/,'');
  if (name.includes(' - ')) {
    const parts = name.split(' - ');
    document.getElementById('uArtista').value = parts[0];
    document.getElementById('uTitulo').value = parts[1];
  } else {
    document.getElementById('uTitulo').value = name;
  }
}
function saveMusic() {
  const titulo = document.getElementById('uTitulo').value.trim();
  const artista = document.getElementById('uArtista').value.trim();
  if (!titulo || !artista) { showToast('Preencha título e artista!'); return; }
  const musicas = ls('jfm_musicas', []);
  musicas.push({ titulo, artista, genero: document.getElementById('uGenero').value, status: 'ativo' });
  ss('jfm_musicas', musicas);
  clearUpload();
  renderMusicTable();
  showToast('✅ Música salva na biblioteca!');
}
function clearUpload() {
  ['uTitulo','uArtista','uAlbum'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('fileInfo').style.display = 'none';
  document.getElementById('fileInput').value = '';
}

// ============================================================
// PEDIDOS
// ============================================================
function renderPedidos() {
  const list = ls('jfm_pedidos', []);
  const el = document.getElementById('pedidosList');
  if (!list.length) {
    el.innerHTML = '<p style="color:var(--muted);font-size:13px;text-align:center;padding:20px">Nenhum pedido ainda.</p>';
    return;
  }
  el.innerHTML = '';
  list.filter(p => p.status === 'aguardando').forEach((p, i) => {
    const div = document.createElement('div');
    div.className = 'req-item';
    div.innerHTML = `
      <div class="req-avatar">${p.nome.substring(0,2).toUpperCase()}</div>
      <div class="req-info">
        <div class="req-name">${p.nome}</div>
        <div class="req-song">${p.musica}${p.dedica?' · '+p.dedica:''}</div>
      </div>
      <span class="req-time">${p.hora}</span>
      <button class="req-btn rb-ok" onclick="approveReq(${i})">✓ Tocar</button>
      <button class="req-btn rb-no" onclick="rejectReq(${i})">✕</button>
    `;
    el.appendChild(div);
  });
}
function addPedido() {
  const nome = document.getElementById('pNome').value.trim();
  const musica = document.getElementById('pMusica').value.trim();
  if (!nome || !musica) { showToast('Preencha nome e música!'); return; }
  const pedidos = ls('jfm_pedidos', []);
  const now = new Date();
  pedidos.push({ nome, musica, dedica: document.getElementById('pDedica').value, hora: now.getHours()+':'+String(now.getMinutes()).padStart(2,'0'), status:'aguardando' });
  ss('jfm_pedidos', pedidos);
  document.getElementById('pNome').value = '';
  document.getElementById('pMusica').value = '';
  document.getElementById('pDedica').value = '';
  renderPedidos();
  refreshStats();
  showToast('Pedido adicionado!');
}
function approveReq(i) {
  const pedidos = ls('jfm_pedidos', []);
  const pending = pedidos.filter(p => p.status === 'aguardando');
  if (pending[i]) { pending[i].status = 'aprovado'; showToast('✅ Pedido aprovado: ' + pending[i].musica); }
  ss('jfm_pedidos', pedidos);
  renderPedidos(); refreshStats();
}
function rejectReq(i) {
  const pedidos = ls('jfm_pedidos', []);
  const pending = pedidos.filter(p => p.status === 'aguardando');
  if (pending[i]) { pending[i].status = 'recusado'; showToast('Pedido recusado.'); }
  ss('jfm_pedidos', pedidos);
  renderPedidos(); refreshStats();
}
function clearPedidos() {
  ss('jfm_pedidos', []);
  renderPedidos(); refreshStats();
  showToast('Lista de pedidos limpa!');
}

// ============================================================
// PUBLICIDADE
// ============================================================
function saveAnunciante() {
  const nome = document.getElementById('anNome').value.trim();
  if (!nome) { showToast('Informe o nome da empresa!'); return; }
  const anunc = ls('jfm_anunc', []);
  anunc.push({ nome, contato: document.getElementById('anContato').value, horario: document.getElementById('anHorario').value, freq: document.getElementById('anFreq').value, texto: document.getElementById('anTexto').value });
  ss('jfm_anunc', anunc);
  loadAnunciantes();
  document.getElementById('anNome').value = '';
  document.getElementById('anContato').value = '';
  document.getElementById('anTexto').value = '';
  showToast('✅ Anunciante cadastrado!');
}
function loadAnunciantes() {
  const anunc = ls('jfm_anunc', []);
  document.getElementById('spotsCount').textContent = anunc.length;
  document.getElementById('anuncCount').textContent = anunc.length;
  const card = document.getElementById('anunciantesList');
  if (!anunc.length) { card.style.display = 'none'; return; }
  card.style.display = 'block';
  const body = document.getElementById('anuncBody');
  body.innerHTML = '';
  anunc.forEach((a, i) => {
    const d = document.createElement('div');
    d.className = 'sch-item';
    d.innerHTML = `<span class="sch-time" style="width:auto;margin-right:8px">${a.nome}</span><div><div class="sch-show" style="font-size:12px">${a.horario} · ${a.freq}</div><div class="sch-host">${a.contato}</div></div><button class="sch-edit" onclick="deleteAnunc(${i})"><i class="fas fa-trash"></i></button>`;
    body.appendChild(d);
  });
}
function deleteAnunc(i) {
  const anunc = ls('jfm_anunc', []);
  anunc.splice(i, 1);
  ss('jfm_anunc', anunc);
  loadAnunciantes();
  showToast('Anunciante removido!');
}

// ============================================================
// CONFIG
// ============================================================
function loadConfig() {
  const cfg = loadCfg();
  document.getElementById('cfUser').value = cfg.user || '';
  document.getElementById('cfStream').value = cfg.stream || '';
  document.getElementById('cfWhats').value = cfg.whats || '';
  document.getElementById('cfSite').value = cfg.site || '';
}
function saveConfig() {
  const cfg = loadCfg();
  const newUser = document.getElementById('cfUser').value.trim();
  const newPass = document.getElementById('cfPass').value.trim();
  cfg.stream = document.getElementById('cfStream').value.trim();
  cfg.whats = document.getElementById('cfWhats').value.trim();
  cfg.site = document.getElementById('cfSite').value.trim();
  if (newUser) cfg.user = newUser;
  if (newPass) cfg.pass = newPass;
  saveCfg(cfg);
  showToast('✅ Configurações salvas!');
}

// ============================================================
// TOAST
// ============================================================
function showToast(msg, dur = 3000) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), dur);
}
</script>
