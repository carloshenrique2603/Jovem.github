            <div class="form-row2">
              <div class="form-group"><label class="form-label">URL do Site</label><input class="form-input" id="cfSite" placeholder="https://seuuser.github.io/radiojovemfm"></div>
              <div class="form-group"><label class="form-label">WhatsApp da Rádio</label><input class="form-input" id="cfWhats" placeholder="5545999999999"></div>
            </div>
          </div>
          <div style="border-top:1px solid var(--border);padding-top:16px;margin-top:4px">
            <div class="card-title" style="margin-bottom:12px"><i class="fas fa-lock"></i> Acesso ao Admin</div>
            <div class="form-row2">
              <div class="form-group"><label class="form-label">Novo Usuário</label><input class="form-input" id="cfUser" placeholder="admin"></div>
              <div class="form-group"><label class="form-label">Nova Senha</label><input class="form-input" type="password" id="cfPass" placeholder="nova senha"></div>
