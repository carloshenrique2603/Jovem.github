<script>
// ---- CONFIGURAÇÕES — EDITE AQUI ----
const STREAM_URL = "https://SEU_SERVIDOR_STREAM:8000/stream"; // ← coloque sua URL de stream
const WHATSAPP_NUMERO = "5545999999999"; // ← seu número com DDI+DDD
// ------------------------------------

const audio = document.getElementById('radioAudio');
audio.src = STREAM_URL;
let playing = false;

function togglePlay() {
  if (!playing) {
    audio.play().catch(() => showToast("Configure a URL do stream no código!"));
    playing = true;
    document.getElementById('playIcon').className = 'fas fa-pause';
    document.getElementById('vinylDisc').classList.add('spinning');
    document.getElementById('songTitle').textContent = 'Rádio Jovem FM';
    document.getElementById('songArtist').textContent = 'Ao Vivo';
    startViz();
  } else {
    audio.pause();
    playing = false;
    document.getElementById('playIcon').className = 'fas fa-play';
    document.getElementById('vinylDisc').classList.remove('spinning');
    stopViz();
  }
}

function setVolume(v) { audio.volume = v / 100; }

let vizBars = [], vizTimer;
function buildViz() {
  const el = document.getElementById('viz');
  el.innerHTML = '';
  vizBars = [];
  for (let i = 0; i < 12; i++) {
    const b = document.createElement('div');
    b.className = 'v-bar';
    b.style.cssText = `width:4px;border-radius:2px 2px 0 0;background:linear-gradient(180deg,#E91E8C,#F5A623);height:4px;transition:height .15s`;
    el.appendChild(b);
    vizBars.push(b);
  }
}
function startViz() {
  buildViz();
  vizTimer = setInterval(() => {
    vizBars.forEach(b => { b.style.height = (4 + Math.random() * 26) + 'px'; });
  }, 150);
}
function stopViz() {
  clearInterval(vizTimer);
  vizBars.forEach(b => { b.style.height = '4px'; });
}
buildViz();

function enviarPedido() {
  const nome = document.getElementById('fNome').value.trim();
  const musica = document.getElementById('fMusica').value.trim();
  const dedica = document.getElementById('fDedica').value.trim();
  const whats = document.getElementById('fWhats').value.trim();
  if (!nome || !musica) { showToast('Preencha seu nome e a música!'); return; }
  let msg = `🎵 *PEDIDO – Rádio Jovem FM*\n\n👤 *Ouvinte:* ${nome}`;
  if (whats) msg += `\n📱 *WhatsApp:* ${whats}`;
  msg += `\n🎶 *Música:* ${musica}`;
  if (dedica) msg += `\n💌 *Dedicatória:* ${dedica}`;
  const url = `https://wa.me/${WHATSAPP_NUMERO}?text=${encodeURIComponent(msg)}`;
  window.open(url, '_blank');
  showToast('Abrindo WhatsApp para enviar seu pedido! 🎶');
  document.getElementById('fNome').value = '';
  document.getElementById('fMusica').value = '';
  document.getElementById('fDedica').value = '';
  document.getElementById('fWhats').value = '';
}

function showToast(msg, dur = 3000) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), dur);
}

function toggleMenu() {
  document.getElementById('mobileMenu').classList.toggle('open');
}

// Particles
(function() {
  const c = document.getElementById('particles');
  const colors = ['#F5A623','#E8650A','#E91E8C','#00C2FF'];
  for (let i = 0; i < 28; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = 2 + Math.random() * 5;
    p.style.cssText = `width:${size}px;height:${size}px;left:${Math.random()*100}%;background:${colors[Math.floor(Math.random()*colors.length)]};animation-duration:${8+Math.random()*14}s;animation-delay:${Math.random()*10}s`;
    c.appendChild(p);
  }
})();

// Fake listener count flicker
setInterval(() => {
  const base = 1200 + Math.floor(Math.random() * 200);
  document.getElementById('listenerCount').textContent = base.toLocaleString('pt-BR');
}, 8000);
</script>
